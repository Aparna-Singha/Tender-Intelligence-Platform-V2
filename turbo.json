{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NEXT_PUBLIC_API_URL"],
  "globalPassThroughEnv": [
    "API_HOST",
    "API_PORT",
    "DATABASE_URL",
    "EMAIL_DELIVERY_TOKEN",
    "EMAIL_DELIVERY_URL",
    "EMAIL_FROM",
    "COOKIE_SECRET",
    "AUTH_RATE_LIMIT_MAX",
    "AUTH_RATE_LIMIT_WINDOW_SECONDS",
    "INVITATION_TTL_SECONDS",
    "LOG_LEVEL",
    "NODE_ENV",
    "QUEUE_NAME",
    "PASSWORD_RESET_TTL_SECONDS",
    "REDIS_URL",
    "REQUEST_ID_HEADER",
    "S3_ACCESS_KEY_ID",
    "S3_BUCKET",
    "S3_ENDPOINT",
    "S3_FORCE_PATH_STYLE",
    "S3_REGION",
    "S3_SECRET_ACCESS_KEY",
    "SESSION_COOKIE_SECURE",
    "SESSION_TTL_SECONDS",
    "TRUST_PROXY",
    "WEB_PORT",
    "WEB_APP_URL",
    "WEB_ORIGIN",
    "WORKER_HEALTH_HOST",
    "WORKER_HEALTH_PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build", "^lint"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
