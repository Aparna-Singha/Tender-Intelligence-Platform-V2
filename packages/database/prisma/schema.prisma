  structuredRequirement StructuredRequirement? @relation(fields: [structuredRequirementId], references: [id], onDelete: Cascade)

  @@index([extractionRunId, tenderDocumentId, pageNumber])
  @@index([extractedTenderFieldId])
  @@index([structuredRequirementId])
  @@map("extraction_citations")
}

model ExtractionIssue {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  extractionRunId       String        @map("extraction_run_id") @db.Uuid
  issueType             String        @map("issue_type") @db.VarChar(80)
  severity              String        @db.VarChar(20)
  safeMessage           String        @map("safe_message") @db.VarChar(500)
  sourceDocumentId      String?       @map("source_document_id") @db.Uuid
  extractedUnitId       String?       @map("extracted_unit_id") @db.Uuid
  requiresHumanReview   Boolean       @default(false) @map("requires_human_review")
  resolvedAt            DateTime?     @map("resolved_at") @db.Timestamptz(3)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  extractionRun         ExtractionRun @relation(fields: [extractionRunId], references: [id], onDelete: Cascade)

  @@index([extractionRunId, issueType, resolvedAt])
  @@map("extraction_issues")
}

model ExtractionReview {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId        String                 @map("organisation_id") @db.Uuid
  extractionRunId       String                 @map("extraction_run_id") @db.Uuid
  targetType            ExtractionReviewTarget @map("target_type")
  targetId              String                 @map("target_id") @db.Uuid
  action                ExtractionReviewAction
  previousValue         String?                @map("previous_value") @db.Text
  correctedValue        String?                @map("corrected_value") @db.Text
  reason                String                 @db.VarChar(1000)
  reviewVersion         Int                    @map("review_version")
  actorUserId           String                 @map("actor_user_id") @db.Uuid
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  organisation          Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  extractionRun         ExtractionRun          @relation(fields: [extractionRunId], references: [id], onDelete: Cascade)
  actor                 User                   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([extractionRunId, targetType, targetId, reviewVersion])
  @@index([organisationId, extractionRunId, targetType, targetId])
  @@map("extraction_reviews")
}
