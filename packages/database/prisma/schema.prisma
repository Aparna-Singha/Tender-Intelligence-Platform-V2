  tenderVersion        TenderVersion                  @relation(fields: [tenderVersionId], references: [id], onDelete: Restrict)
  assignee             User?                          @relation(fields: [assigneeUserId], references: [id], onDelete: Restrict)
  generationRun        ChecklistGenerationRun         @relation(fields: [generationRunId], references: [id], onDelete: Cascade)
  assessmentLinks      ChecklistItemAssessmentLink[]
  requirementLinks     ChecklistItemRequirementLink[]
  sourceCitations      ChecklistItemSourceCitation[]
  history              ChecklistItemHistory[]

  @@unique([generationRunId, deduplicationKey])
  @@index([organisationId, tenderId, generationRunId, status, currentPriority])
  @@index([organisationId, assigneeUserId, currentDueDate])
  @@map("checklist_items")
}

model ChecklistItemAssessmentLink {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checklistItemId         String                @map("checklist_item_id") @db.Uuid
  eligibilityAssessmentId String                @map("eligibility_assessment_id") @db.Uuid
  assessmentState         EligibilityState      @map("assessment_state")
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  checklistItem           ChecklistItem         @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  eligibilityAssessment   EligibilityAssessment @relation(fields: [eligibilityAssessmentId], references: [id], onDelete: Restrict)

  @@unique([checklistItemId, eligibilityAssessmentId])
  @@index([eligibilityAssessmentId])
  @@map("checklist_item_assessment_links")
}

model ChecklistItemRequirementLink {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checklistItemId         String                @map("checklist_item_id") @db.Uuid
  structuredRequirementId String                @map("structured_requirement_id") @db.Uuid
  requirementCategory     String                @map("requirement_category") @db.VarChar(80)
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  checklistItem           ChecklistItem         @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  structuredRequirement   StructuredRequirement @relation(fields: [structuredRequirementId], references: [id], onDelete: Restrict)

  @@unique([checklistItemId, structuredRequirementId])
  @@index([structuredRequirementId])
  @@map("checklist_item_requirement_links")
}

model ChecklistItemSourceCitation {
  id                   String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checklistItemId      String                   @map("checklist_item_id") @db.Uuid
  extractionCitationId String                   @map("extraction_citation_id") @db.Uuid
  evidenceCitationId   String?                  @map("evidence_citation_id") @db.Uuid
  sourceKind           String                   @map("source_kind") @db.VarChar(40)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  checklistItem        ChecklistItem            @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  extractionCitation   ExtractionCitation       @relation(fields: [extractionCitationId], references: [id], onDelete: Restrict)
  evidenceCitation     CompanyEvidenceCitation? @relation(fields: [evidenceCitationId], references: [id], onDelete: Restrict)

  @@unique([checklistItemId, extractionCitationId, evidenceCitationId])
  @@index([extractionCitationId])
  @@map("checklist_item_source_citations")
}

model ChecklistItemHistory {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId     String                 @map("organisation_id") @db.Uuid
  checklistItemId    String                 @map("checklist_item_id") @db.Uuid
  action             ChecklistHistoryAction
  previousState      ChecklistItemStatus?   @map("previous_state")
  newState           ChecklistItemStatus?   @map("new_state")
  previousPriority   ChecklistPriority?     @map("previous_priority")
  newPriority        ChecklistPriority?     @map("new_priority")
  previousAssigneeId String?                @map("previous_assignee_id") @db.Uuid
  newAssigneeId      String?                @map("new_assignee_id") @db.Uuid
  rationale          String                 @db.VarChar(1000)
  actorUserId        String?                @map("actor_user_id") @db.Uuid
  eventVersion       Int                    @map("event_version")
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  checklistItem      ChecklistItem          @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  organisation       Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  actor              User?                  @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([checklistItemId, eventVersion])
  @@index([organisationId, checklistItemId, createdAt])
  @@map("checklist_item_history")
}
