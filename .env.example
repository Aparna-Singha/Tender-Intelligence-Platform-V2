# Copy this file to .env for local development only.
# Values below are local placeholders and must never be reused outside development.
NODE_ENV=development

POSTGRES_DB=tender_intelligence
POSTGRES_USER=tender_platform
POSTGRES_PASSWORD=replace-with-local-postgres-password
DATABASE_URL=postgresql://tender_platform:replace-with-local-postgres-password@localhost:5432/tender_intelligence?schema=public

REDIS_URL=redis://localhost:6379

MINIO_ROOT_USER=replace-with-local-minio-user
MINIO_ROOT_PASSWORD=replace-with-local-minio-password
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tender-intelligence-local
S3_ACCESS_KEY_ID=replace-with-local-minio-user
S3_SECRET_ACCESS_KEY=replace-with-local-minio-password
S3_FORCE_PATH_STYLE=true

API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=4001

LOG_LEVEL=info
REQUEST_ID_HEADER=x-request-id
QUEUE_NAME=platform-jobs
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
DOCUMENT_UPLOAD_TTL_SECONDS=300
DOCUMENT_DOWNLOAD_TTL_SECONDS=60
DOCUMENT_JOB_TIMEOUT_MS=60000
EXTRACTION_JOB_TIMEOUT_MS=300000
RAG_JOB_TIMEOUT_MS=180000
# Optional. When absent, RAG jobs fail clearly with PROVIDER_UNAVAILABLE.
# Configure only in a local untracked .env or approved secret manager.
# GEMINI_API_KEY=replace-with-local-provider-key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_PROVIDER=gemini
RAG_CHAT_MODEL=gemini-2.5-flash
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_RATE_LIMIT_MAX=30
TRUST_PROXY=false

# Use a randomly generated value of at least 32 characters.
COOKIE_SECRET=replace-with-a-random-local-cookie-secret
# Secure must be true in HTTPS environments. Local HTTP development uses false.
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800
PASSWORD_RESET_TTL_SECONDS=3600
INVITATION_TTL_SECONDS=604800
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Configure all three values together to enable password reset and invitation email.
# Production startup rejects missing email delivery configuration.
# EMAIL_DELIVERY_URL=https://transactional-email.example.test/deliver
# EMAIL_DELIVERY_TOKEN=replace-with-email-delivery-token
# EMAIL_FROM=no-reply@example.test
