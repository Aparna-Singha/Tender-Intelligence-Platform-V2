{
  "name": "@tender/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "clean": "rm -rf .next",
    "dev": "next dev --hostname 0.0.0.0 --port ${WEB_PORT:-3000}",
    "lint": "eslint src next.config.ts",
    "start": "next start --hostname 0.0.0.0 --port ${WEB_PORT:-3000}",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tender/config": "workspace:*",
    "@tender/ui": "workspace:*",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
