{
  "name": "tender-intelligence-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Production monorepo foundation for Tender Intelligence Platform",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production dotenv -e .env -- turbo run build",
    "clean": "turbo run clean --concurrency=1 --output-logs=full && rimraf .turbo coverage",
    "db:generate": "dotenv -e .env -- pnpm --filter @tender/database db:generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @tender/database db:migrate",
    "db:migrate:deploy": "dotenv -e .env -- pnpm --filter @tender/database db:migrate:deploy",
    "doctor": "node tools/doctor.mjs",
    "dev": "cross-env NODE_ENV=development dotenv -e .env -- turbo run dev --parallel",
    "dev:api": "cross-env NODE_ENV=development dotenv -e .env -- pnpm --filter @tender/api dev",
    "dev:infra": "docker compose up -d",
    "dev:infra:down": "docker compose down",
    "dev:web": "cross-env NODE_ENV=development dotenv -e .env -- pnpm --filter @tender/web dev",
    "dev:worker": "cross-env NODE_ENV=development dotenv -e .env -- pnpm --filter @tender/worker dev",
    "eval:offline": "cross-env NODE_ENV=test tsx tools/eval-offline.mjs",
    "eval:provider": "cross-env NODE_ENV=test dotenv -e .env -- tsx tools/eval-provider.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "dotenv -e .env -- turbo run lint && markdownlint-cli2 \"**/*.md\"",
    "playwright:install": "playwright install chromium",
    "test:browser": "cross-env NODE_ENV=test dotenv -e .env -- playwright test",
    "test": "cross-env NODE_ENV=test dotenv -e .env -- turbo run test",
    "typecheck": "dotenv -e .env -- turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.55.1",
    "@types/node": "24.10.13",
    "cross-env": "10.1.0",
    "dotenv-cli": "11.0.0",
    "eslint": "10.0.2",
    "eslint-config-prettier": "10.1.8",
    "markdownlint-cli2": "0.23.2",
    "pg": "8.22.0",
    "prettier": "3.9.0",
    "rimraf": "6.1.3",
    "tsx": "4.23.1",
    "turbo": "2.10.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vitest": "4.1.0"
  }
}
