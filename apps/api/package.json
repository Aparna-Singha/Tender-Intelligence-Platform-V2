{
  "name": "@tender/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "dev": "nest start --watch --preserveWatchOutput",
    "lint": "eslint src test",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1097.0",
    "@aws-sdk/s3-request-presigner": "3.1097.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/static": "9.3.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@tender/config": "workspace:*",
    "@tender/contracts": "workspace:*",
    "@tender/database": "workspace:*",
    "@tender/domain": "workspace:*",
    "@tender/observability": "workspace:*",
    "bullmq": "5.81.2",
    "fastify": "5.10.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.16",
    "@nestjs/testing": "11.1.28",
    "@types/node": "24.10.13",
    "rimraf": "6.1.3"
  }
