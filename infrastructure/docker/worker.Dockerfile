FROM node:22.18.0-alpine AS build
WORKDIR /workspace
RUN corepack enable

COPY . .
ENV DATABASE_URL=postgresql://build:build@localhost:5432/build
RUN pnpm install --frozen-lockfile
RUN pnpm turbo run build --filter=@tender/worker...
RUN pnpm deploy --filter=@tender/worker --prod /output
# pnpm deploy installs a fresh, ungenerated @prisma/client; carry over the
# client generated by the database build into the deployed virtual store.
RUN node -e 'const fs=require("node:fs");const path=require("node:path");const {createRequire}=require("node:module");const source=require.resolve("@prisma/client/package.json",{paths:["/workspace/packages/database"]});const database=fs.realpathSync("/output/node_modules/@tender/database/package.json");const target=createRequire(database).resolve("@prisma/client/package.json");fs.cpSync(path.dirname(source),path.dirname(target),{recursive:true,force:true});fs.cpSync(path.resolve(path.dirname(source),"../..",".prisma"),path.resolve(path.dirname(target),"../..",".prisma"),{recursive:true,force:true})'

FROM node:22.18.0-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /output ./
EXPOSE 4001
USER node
CMD ["node", "dist/main.js"]
