generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrganisationType {
  MSME
  CONSULTANT
}

enum Role {
  OWNER
  ADMIN
  TENDER_EXECUTIVE
  CONSULTANT
  REVIEWER
  PLATFORM_ADMIN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum AuditEventType {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT
  ORGANISATION_CREATED
  INVITATION_CREATED
  INVITATION_ACCEPTED
  ROLE_CHANGED
  SESSION_REVOKED
  PASSWORD_RESET_COMPLETED
  ONBOARDING_STEP_SAVED
  ONBOARDING_COMPLETED
  COMPANY_PROFILE_UPDATED
  DOCUMENT_UPLOAD_REQUESTED
  DOCUMENT_UPLOAD_COMPLETED
  DOCUMENT_DOWNLOADED
  DOCUMENT_DELETED
  DOCUMENT_VERSION_CREATED
}

enum DocumentCategory {
  UDYAM
  GST
  PAN
  CIN
  AUDITED_FINANCIAL_STATEMENT
  TURNOVER_CERTIFICATE
  PURCHASE_ORDER
  COMPLETION_CERTIFICATE
  EXPERIENCE_CERTIFICATE
  OEM_AUTHORISATION
  ISO_CERTIFICATE
  LICENCE
  PRODUCT_DATASHEET
  DECLARATION
  BANK_DOCUMENT
  OTHER
}

enum DocumentStatus {
  UPLOADING
  UPLOADED
  SCANNING
  QUARANTINED
  PROCESSING
  READY
  REJECTED
  FAILED
  EXPIRED
}

enum DocumentVerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
  HUMAN_REVIEW_REQUIRED
}

enum UploadSessionStatus {
  PENDING
  COMPLETED
  EXPIRED
  CANCELLED
}

enum VerificationStatus {
  SELF_DECLARED
  DOCUMENT_VERIFIED
  EXPIRED
  CONFLICTING
  HUMAN_REVIEW_REQUIRED
}

enum ProfileValueSource {
  USER_INPUT
  ADMIN_INPUT
  DOCUMENT
}

enum ProfileValueType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  TEXT_LIST
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model User {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String               @unique @db.VarChar(320)
  passwordHash        String               @map("password_hash")
  displayName         String               @map("display_name") @db.VarChar(120)
  platformRole        Role?                @map("platform_role")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions            Session[]
  memberships         OrganisationMembership[]
  createdOrganisations Organisation[]      @relation("OrganisationCreator")
  sentInvitations     Invitation[]          @relation("InvitationSender")
  acceptedInvitations Invitation[]          @relation("InvitationAcceptor")
  passwordResetTokens PasswordResetToken[]
  auditEvents         AuditEvent[]          @relation("AuditActor")
  onboardingProgress  OnboardingProgress[]
  updatedProfileValues CompanyProfileValue[] @relation("ProfileValueUpdater")
  ownedDocuments       Document[]             @relation("DocumentOwner")
  uploadedDocumentVersions DocumentVersion[]  @relation("DocumentVersionUploader")
  documentVerifications DocumentVerification[] @relation("DocumentVerifier")
  documentAccessEvents DocumentAccessEvent[]

  @@map("users")
}

model Session {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  activeOrganisationId String? @map("active_organisation_id") @db.Uuid
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  ipHash        String?   @map("ip_hash") @db.Char(64)
  userAgentHash String?   @map("user_agent_hash") @db.Char(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganisation Organisation? @relation(fields: [activeOrganisationId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt, expiresAt])
  @@map("sessions")
}

model Organisation {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String               @db.VarChar(160)
  type           OrganisationType
  createdByUserId String               @map("created_by_user_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy      User                 @relation("OrganisationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  memberships    OrganisationMembership[]
  invitations    Invitation[]
  sessions       Session[]
  auditEvents    AuditEvent[]
  onboardingProgress OnboardingProgress[]
  companyProfile CompanyProfile?
  profileValues CompanyProfileValue[]
  turnoverRecords CompanyTurnover[]
  documentReadiness DocumentReadiness[]
  documents       Document[]
  uploadSessions  UploadSession[]
  documentAccessEvents DocumentAccessEvent[]

  @@map("organisations")
}

model OrganisationMembership {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           Role
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  revokedAt      DateTime?    @map("revoked_at") @db.Timestamptz(3)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@index([userId, revokedAt])
  @@map("organisation_memberships")
}

model Invitation {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String           @map("organisation_id") @db.Uuid
  email          String           @db.VarChar(320)
  role           Role
  tokenHash      String           @unique @map("token_hash") @db.Char(64)
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(3)
  invitedByUserId String          @map("invited_by_user_id") @db.Uuid
  acceptedByUserId String?        @map("accepted_by_user_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz(3)
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invitedBy      User             @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy     User?            @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, status])
  @@index([email, status])
  @@map("invitations")
}

model PasswordResetToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt])
  @@map("password_reset_tokens")
}

model AuditEvent {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType      AuditEventType @map("event_type")
  actorUserId    String?        @map("actor_user_id") @db.Uuid
  organisationId String?        @map("organisation_id") @db.Uuid
  subjectType    String?        @map("subject_type") @db.VarChar(80)
  subjectId      String?        @map("subject_id") @db.Uuid
  outcome        String         @db.VarChar(32)
  requestId      String?        @map("request_id") @db.VarChar(128)
  ipHash         String?        @map("ip_hash") @db.Char(64)
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  actor          User?          @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  organisation   Organisation?  @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([eventType, createdAt])
  @@map("audit_events")
}

model OnboardingProgress {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  currentStep    Int          @default(1) @map("current_step")
  completedSteps Int[]        @default([]) @map("completed_steps")
  status         OnboardingStatus @default(NOT_STARTED)
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@map("onboarding_progress")
}

model CompanyProfile {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String       @unique @map("organisation_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@map("company_profiles")
}

model CompanyProfileValue {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId     String             @map("organisation_id") @db.Uuid
  fieldKey           String             @map("field_key") @db.VarChar(80)
  valueType          ProfileValueType   @map("value_type")
  textValue          String?            @map("text_value")
  numberValue        Decimal?           @map("number_value") @db.Decimal(18, 2)
  booleanValue       Boolean?           @map("boolean_value")
  dateValue          DateTime?          @map("date_value") @db.Date
  textListValue      String[]           @default([]) @map("text_list_value")
  source             ProfileValueSource @default(USER_INPUT)
  verificationStatus VerificationStatus @default(SELF_DECLARED) @map("verification_status")
  evidenceDocumentId String?            @map("evidence_document_id") @db.Uuid
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedByUserId    String             @map("updated_by_user_id") @db.Uuid
  organisation       Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  updatedBy          User               @relation("ProfileValueUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@unique([organisationId, fieldKey])
  @@index([organisationId, verificationStatus])
  @@map("company_profile_values")
}

model CompanyTurnover {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId     String             @map("organisation_id") @db.Uuid
  financialYear      String             @map("financial_year") @db.VarChar(7)
  amountInr          Decimal            @map("amount_inr") @db.Decimal(18, 2)
  source             ProfileValueSource @default(USER_INPUT)
  verificationStatus VerificationStatus @default(SELF_DECLARED) @map("verification_status")
  evidenceDocumentId String?            @map("evidence_document_id") @db.Uuid
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedByUserId    String             @map("updated_by_user_id") @db.Uuid
  organisation       Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, financialYear])
  @@map("company_turnover")
}

model DocumentReadiness {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId     String             @map("organisation_id") @db.Uuid
  documentType       String             @map("document_type") @db.VarChar(80)
  readinessStatus    String             @map("readiness_status") @db.VarChar(24)
  expectedExpiry     DateTime?          @map("expected_expiry") @db.Date
  source             ProfileValueSource @default(USER_INPUT)
  verificationStatus VerificationStatus @default(SELF_DECLARED) @map("verification_status")
  evidenceDocumentId String?            @map("evidence_document_id") @db.Uuid
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedByUserId    String             @map("updated_by_user_id") @db.Uuid
  organisation       Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, documentType])
  @@map("document_readiness")
}

model Document {
  id                 String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId     String                     @map("organisation_id") @db.Uuid
  ownerUserId        String                     @map("owner_user_id") @db.Uuid
  category           DocumentCategory
  displayName        String                     @map("display_name") @db.VarChar(255)
  status             DocumentStatus             @default(UPLOADING)
  verificationStatus DocumentVerificationStatus @default(UNVERIFIED) @map("verification_status")
  expiryDate         DateTime?                  @map("expiry_date") @db.Date
  currentVersionId   String?                    @unique @map("current_version_id") @db.Uuid
  retentionUntil     DateTime?                  @map("retention_until") @db.Timestamptz(3)
  deletionRequestedAt DateTime?                 @map("deletion_requested_at") @db.Timestamptz(3)
  deletedAt          DateTime?                  @map("deleted_at") @db.Timestamptz(3)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  organisation       Organisation               @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  owner              User                       @relation("DocumentOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  currentVersion     DocumentVersion?           @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions           DocumentVersion[]          @relation("DocumentVersions")
  verifications      DocumentVerification[]
  accessEvents       DocumentAccessEvent[]

  @@index([organisationId, category, status])
  @@index([organisationId, expiryDate])
  @@map("documents")
}

model DocumentVersion {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId         String         @map("document_id") @db.Uuid
  versionNumber      Int            @map("version_number")
  originalFilename   String         @map("original_filename") @db.VarChar(255)
  declaredMimeType   String         @map("declared_mime_type") @db.VarChar(120)
  detectedMimeType   String?        @map("detected_mime_type") @db.VarChar(120)
  extension          String         @db.VarChar(16)
  sizeBytes          BigInt         @map("size_bytes")
  sha256             String         @db.Char(64)
  quarantineObjectKey String        @unique @map("quarantine_object_key") @db.VarChar(512)
  approvedObjectKey  String?        @unique @map("approved_object_key") @db.VarChar(512)
  uploadedByUserId   String         @map("uploaded_by_user_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  document           Document       @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentForDocument Document?      @relation("CurrentDocumentVersion")
  uploadedBy         User           @relation("DocumentVersionUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  uploadSession      UploadSession?
  extraction         DocumentExtraction?

  @@unique([documentId, versionNumber])
  @@index([sha256])
  @@map("document_versions")
}

model UploadSession {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId     String              @map("organisation_id") @db.Uuid
  documentVersionId  String              @unique @map("document_version_id") @db.Uuid
  status             UploadSessionStatus @default(PENDING)
  expiresAt          DateTime            @map("expires_at") @db.Timestamptz(3)
  completedAt        DateTime?           @map("completed_at") @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  organisation       Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  documentVersion    DocumentVersion     @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@index([organisationId, status, expiresAt])
  @@map("upload_sessions")
}

model DocumentExtraction {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentVersionId String          @unique @map("document_version_id") @db.Uuid
  status            DocumentStatus
  metadata          Json?
  failureCode       String?         @map("failure_code") @db.VarChar(80)
  startedAt         DateTime?       @map("started_at") @db.Timestamptz(3)
  completedAt       DateTime?       @map("completed_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@map("document_extractions")
}

model DocumentVerification {
  id             String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId     String                     @map("document_id") @db.Uuid
  status         DocumentVerificationStatus
  rationale      String?                    @db.VarChar(1000)
  verifiedByUserId String?                  @map("verified_by_user_id") @db.Uuid
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  document       Document                   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  verifiedBy     User?                      @relation("DocumentVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
  @@map("document_verifications")
}

model DocumentAccessEvent {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  documentId     String       @map("document_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  action         String       @db.VarChar(32)
  outcome        String       @db.VarChar(32)
  requestId      String?      @map("request_id") @db.VarChar(128)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organisationId, documentId, createdAt])
  @@map("document_access_events")
}
