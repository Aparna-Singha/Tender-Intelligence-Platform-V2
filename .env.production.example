# Template only. Copy to an untracked .env.staging on the VM and replace every
# replace-with value using an approved secret manager. Never commit that file.
STAGING_ENV_FILE=.env.staging
IMAGE_TAG=replace-with-reviewed-git-commit-sha
API_PUBLIC_HOST=api.staging.example.test
NODE_ENV=production

# Runtime uses a Neon pooled URL. Run Prisma migrations separately using the
# direct Neon URL; do not place the direct URL in the long-running containers.
DATABASE_URL=postgresql://replace-with-neon-user:replace-with-neon-password@replace-with-pooled-host/replace-with-db?sslmode=require
REDIS_PASSWORD=replace-with-random-redis-password
REDIS_URL=redis://:replace-with-url-encoded-redis-password@redis:6379

S3_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=replace-with-private-staging-bucket
S3_ACCESS_KEY_ID=replace-with-r2-key-id
S3_SECRET_ACCESS_KEY=replace-with-r2-secret
S3_FORCE_PATH_STYLE=true

API_HOST=0.0.0.0
API_PORT=4000
API_METRICS_HOST=127.0.0.1
API_METRICS_PORT=4100
API_PUBLIC_URL=https://api.staging.example.test
WEB_APP_URL=https://web.staging.example.test
WEB_ORIGIN=https://web.staging.example.test
API_PROXY_ORIGIN=https://api.staging.example.test
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_STORAGE_ORIGIN=https://replace-with-account-id.r2.cloudflarestorage.com
SESSION_COOKIE_SECURE=true
TRUST_PROXY=true
COOKIE_SECRET=replace-with-random-secret-of-at-least-32-characters
SESSION_TTL_SECONDS=604800
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=4001
WORKER_METRICS_HOST=127.0.0.1
WORKER_METRICS_PORT=4101
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
QUEUE_NAME=platform-jobs
DOCUMENT_UPLOAD_TTL_SECONDS=300
DOCUMENT_DOWNLOAD_TTL_SECONDS=60
DOCUMENT_JOB_TIMEOUT_MS=60000
EXTRACTION_JOB_TIMEOUT_MS=300000
RAG_JOB_TIMEOUT_MS=180000
DRAFT_JOB_TIMEOUT_MS=600000

RAG_PROVIDER=gemini
DRAFT_PROVIDER=gemini
GEMINI_API_KEY=replace-with-gemini-key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_CHAT_MODEL=gemini-2.5-flash
RAG_EMBEDDING_MODEL=gemini-embedding-001
DRAFT_MODEL=gemini-2.5-flash
RAG_RATE_LIMIT_MAX=30

EMAIL_DELIVERY_URL=https://transactional-email.example.test/deliver
EMAIL_DELIVERY_TOKEN=replace-with-email-service-token
EMAIL_FROM=no-reply@staging.example.test
LOG_LEVEL=info
REQUEST_ID_HEADER=x-request-id
